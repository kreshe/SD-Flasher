        self.open_btn.pack(side="right", pady=14)

    def _is_image(self, path):
        try:
            return path.name.lower().endswith(IMAGE_EXTENSIONS)
        except Exception:
            return False

    def _format_type(self, path):
        if path.is_dir():
            return "Папка"
        n = path.name.lower()
        if n.endswith(".img"):
            return "IMG"
        if n.endswith(".img.xz") or n.endswith(".xz"):
            return "XZ"
        if n.endswith(".img.gz") or n.endswith(".gz"):
            return "GZIP"
        if n.endswith(".img.zst") or n.endswith(".zst"):
            return "ZSTD"
        try:
            return path.suffix.upper().lstrip(".") or "Файл"
        except Exception:
            return "Файл"

    def _format_size(self, path):
        if path.is_dir():
            return "—"
        try:
            return human_bytes(path.stat().st_size)
        except Exception:
            return "—"

    def _format_time(self, path):
        try:
            return time.strftime("%d.%m.%Y %H:%M", time.localtime(path.stat().st_mtime))
        except Exception:
            return "—"

    def refresh(self):
        directory = self.current_dir
        if not directory.exists() or not directory.is_dir():
            directory = HOME
            self.current_dir = directory
        self.path_var.set(str(directory))
        self.file_count_var.set("Загрузка…")
        self.tree.delete(*self.tree.get_children())
        query = self.search_var.get().strip().lower()
        entries = []
        try:
            for p in directory.iterdir():
                if not self.hidden_var.get() and p.name.startswith("."):
                    continue
                if query and query not in p.name.lower():
                    continue
                try:
                    is_dir = p.is_dir()
                except OSError:
                    is_dir = False
                if not is_dir and self.filter_var.get() and not self._is_image(p):
                    continue
                entries.append(p)
        except PermissionError:
            self.file_count_var.set("Нет доступа к папке")
            return
        except OSError as e:
            self.file_count_var.set(str(e))
            return

        entries.sort(key=lambda p: (not p.is_dir(), p.name.lower()))
        for p in entries:
            iid = str(p)
            prefix = "▸  " if p.is_dir() else "▰  "
            self.tree.insert("", "end", iid=iid,
                             values=(prefix + p.name, self._format_type(p), self._format_size(p), self._format_time(p)),
                             tags=("dir" if p.is_dir() else "file",))
        self.tree.tag_configure("dir", foreground=ACCENT_2)
        self.tree.tag_configure("file", foreground=TEXT_2)
        self.file_count_var.set(f"{len(entries)} объектов")
        self._update_nav_buttons()

    def _update_nav_buttons(self):
        self.back_btn.config(state="normal" if self.history else "disabled")

    def go_to(self, path, reset_history=False):
        path = Path(path).expanduser()
        try:
            path = path.resolve()
        except Exception:
            pass
        if not path.exists() or not path.is_dir():
            return
        if path == self.current_dir:
            self.refresh()
            return
        if not reset_history:
            self.history.append(self.current_dir)
        else:
            self.history.clear()
        self.current_dir = path
        self.search_var.set("")
        self.refresh()

    def go_back(self):
        if not self.history:
            return
        self.current_dir = self.history.pop()
        self.search_var.set("")
        self.refresh()

    def go_up(self):
        if self.current_dir.parent != self.current_dir:
            self.go_to(self.current_dir.parent)

    def go_path_entry(self):
        raw = self.path_var.get().strip()
        if not raw:
            return
        self.go_to(raw)

    def on_tree_select(self, _event=None):
        item = self.tree.selection()
        if not item:
            self.selection_var.set("Файл не выбран")
            self.open_btn.config(state="disabled")
            return
        path = Path(item[0])
        if path.is_file() and self._is_image(path):
            self.selection_var.set(f"{path.name}    ·    {self._format_size(path)}    ·    {path}")
            self.open_btn.config(state="normal")
        elif path.is_dir():
            self.selection_var.set(f"Папка: {path.name}")
            self.open_btn.config(state="disabled")
        else:
            self.selection_var.set("Выберите поддерживаемый образ")
            self.open_btn.config(state="disabled")

    def activate_selected(self):
        item = self.tree.selection()
        if not item:
            return
        path = Path(item[0])
        if path.is_dir():
            self.go_to(path)
            return
        if not path.is_file() or not self._is_image(path):
            return
        self.result = path.resolve()
        self.destroy()

    def cancel(self):
        self.result = None
        self.destroy()


