        self.file_count_var = tk.StringVar(value="")

        initial = Path(initial_path).expanduser() if initial_path else HOME
        try:
            if initial.is_file():
                self.current_dir = initial.parent
            elif initial.is_dir():
                self.current_dir = initial
        except Exception:
            self.current_dir = HOME

        self.title("Выбор образа · SD FLASHER")
        self.geometry("1120x720")
        self.minsize(900, 580)
        self.configure(bg=BG)
        self.transient(parent)
        self.protocol("WM_DELETE_WINDOW", self.cancel)
        self._setup_picker_style()
        self._build_picker_ui()
        self.bind("<Escape>", lambda e: self.cancel())
        self.bind("<Control-KeyPress-l>", lambda e: self.path_entry.focus_set())
        self.bind("<Return>", lambda e: self.activate_selected())
        self.after(60, self._center_on_parent)
        self.refresh()

    def _center_on_parent(self):
        self.update_idletasks()
        try:
            px = self.parent.winfo_rootx()
            py = self.parent.winfo_rooty()
            pw = self.parent.winfo_width()
            ph = self.parent.winfo_height()
            w = self.winfo_width()
            h = self.winfo_height()
            x = max(0, px + (pw - w) // 2)
            y = max(0, py + (ph - h) // 2)
            self.geometry(f"{w}x{h}+{x}+{y}")
        except Exception:
            pass

