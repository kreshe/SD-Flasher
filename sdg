def root_disk():
    _, out, _ = run_cmd(["findmnt", "-n", "-o", "SOURCE", "/"])
    src = out.strip()
    if not src:
        return ""
    _, out, _ = run_cmd(["lsblk", "-no", "PKNAME", src])
    rows = [x.strip() for x in out.splitlines() if x.strip()]
    if rows:
        return "/dev/" + rows[0]
    _, out, _ = run_cmd(["lsblk", "-sno", "NAME", src])
    for line in out.splitlines():
        name = line.strip()
        if re.fullmatch(r"(?:sd[a-z]+|nvme\d+n\d+|mmcblk\d+|vd[a-z]+|xvd[a-z]+|hd[a-z]+)", name):
            return "/dev/" + name
    return ""


def get_disks():
    system = root_disk()
    code, out, err = run_cmd([
        "lsblk", "-J", "-o",
        "NAME,KNAME,PATH,TYPE,SIZE,RM,RO,TRAN,MODEL,SERIAL,MOUNTPOINTS"
    ])
    if code != 0:
        raise RuntimeError(err.strip() or "Не удалось получить список накопителей")
    data = json.loads(out)
    result = []

    for d in data.get("blockdevices", []):
        if d.get("type") != "disk":
            continue
        path = d.get("path") or ("/dev/" + str(d.get("kname", "")))
        if not path or path == system:
            continue

        rm = str(d.get("rm", "0")) == "1"
        ro = str(d.get("ro", "0")) == "1"
        tran = (d.get("tran") or "").lower()
        model = " ".join((d.get("model") or "").split())
        serial = " ".join((d.get("serial") or "").split())
        mounts = [m for m in (d.get("mountpoints") or []) if m]

        _, props, _ = run_cmd(["udevadm", "info", "--query=property", "--name", path])
        udev = {}
        for line in props.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                udev[k] = v

        id_bus = (udev.get("ID_BUS") or "").lower()
        id_model = udev.get("ID_MODEL_FROM_DATABASE") or udev.get("ID_MODEL") or ""
        id_vendor = udev.get("ID_VENDOR_FROM_DATABASE") or udev.get("ID_VENDOR") or ""
        all_names = (model + " " + id_model + " " + id_vendor).lower()
        is_transcend = "transcend" in all_names or "ts-rdf5a" in all_names
        external = rm or tran in {"usb", "mmc", "sd"} or id_bus == "usb" or is_transcend
        if not external:
            continue

        if ro:
            state = "ТОЛЬКО ЧТЕНИЕ"
        elif mounts:
            state = "СМОНТИРОВАН"
        else:
            state = "ГОТОВ"

        display_model = model or id_model or id_vendor or "Неизвестное устройство"
        if is_transcend:
            display_model = f"{display_model} · кардридер"

        result.append({
            "path": path,
            "size": d.get("size") or "—",
            "rm": rm,
            "ro": ro,
            "tran": tran or id_bus or "?",
            "model": display_model,
            "serial": serial or "—",
            "mounts": mounts,
            "state": state,
            "system": system,
            "card_reader": is_transcend,
        })

    result.sort(key=lambda x: x["path"])
    return result


def partitions_of(disk):
    _, out, _ = run_cmd(["lsblk", "-lnpo", "NAME,TYPE", "--", disk])
    parts = []
    for line in out.splitlines():
        cols = line.split(None, 1)
        if len(cols) == 2 and cols[0] and cols[1] != "disk":
            parts.append(cols[0])
    return parts


def mounted_targets(node):
    _, out, _ = run_cmd(["findmnt", "-rn", "-S", node, "-o", "TARGET"])
    return [x.strip() for x in out.splitlines() if x.strip()]


def unmount_disk(disk):
    messages = []
    for node in partitions_of(disk):
        targets = mounted_targets(node)
        for target in targets:
            p = subprocess.run(
                ["sudo", "umount", "--", target],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
            )
            if p.returncode != 0:
                p2 = subprocess.run(
                    ["sudo", "umount", "--", node],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    check=False,
                )
                if p2.returncode != 0:
                    raise RuntimeError(p2.stderr.strip() or f"Не удалось размонтировать {node}")
            messages.append(f"Размонтировано: {node}")
    return messages


class FlashJob:
    def __init__(self, app, device, image, log_path, image_size):
        self.app = app
        self.device = device
        self.image = image
        self.log_path = log_path
        self.image_size = image_size
        self.process = None
        self.thread = None
        self.status = "ПОДГОТОВКА"
        self.written = 0
        self.speed = "—"
        self.percent = None
        self.start = time.monotonic()
        self.elapsed = 0
        self.log_lines = []
        self._stop = False
        self.final_rc = None
        self.widgets = None

    def start_job(self):
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def _build_command(self):
        low = self.image.name.lower()
        if low.endswith(".img"):
            return [
                "sudo", "dd", f"if={self.image}", f"of={self.device}",
                f"bs={BS}", "iflag=fullblock", "status=progress", "conv=fsync"
            ]
        if low.endswith((".img.xz", ".xz")):
            return ["bash", "-c", f'set -o pipefail; xz -dc -- "$1" | sudo dd of="$2" bs={BS} iflag=fullblock status=progress conv=fsync', "bash", str(self.image), self.device]
        if low.endswith((".img.gz", ".gz")):
            return ["bash", "-c", f'set -o pipefail; gzip -dc -- "$1" | sudo dd of="$2" bs={BS} iflag=fullblock status=progress conv=fsync', "bash", str(self.image), self.device]
        if low.endswith((".img.zst", ".zst")):
            return ["bash", "-c", f'set -o pipefail; zstd -dc -- "$1" | sudo dd of="$2" bs={BS} iflag=fullblock status=progress conv=fsync', "bash", str(self.image), self.device]
        raise RuntimeError("Неподдерживаемый формат образа")

    def _append_log(self, line):
        line = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", "", line).strip()
        if not line:
            return
        self.log_lines.append(line)
        self.log_lines = self.log_lines[-12:]
        with open(self.log_path, "a", encoding="utf-8", errors="replace") as f:
            f.write(line + "\n")

    def _parse_status(self, raw):
        for part in re.split(r"[\r\n]+", raw):
            part = part.strip()
            if not part:
                continue
            b = parse_bytes(part)
            if b is not None:
                self.written = b
                if self.image_size:
                    self.percent = min(100, int((b * 100) / self.image_size))
            m = re.search(r",\s*([0-9.]+\s*[A-Za-z]+/s)\s*$", part)
            if m:
                self.speed = m.group(1)
            self._append_log(part)

    def _run(self):
        try:
            LOG_DIR.mkdir(parents=True, exist_ok=True)
            with open(self.log_path, "w", encoding="utf-8") as f:
                f.write(f"DEVICE={self.device}\nIMAGE={self.image}\nSTART={time.strftime('%Y-%m-%d %H:%M:%S')}\n\n")

            self.status = "ЗАПИСЬ"
            cmd = self._build_command()
            self.process = subprocess.Popen(
                cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
            )
            buf = ""
            while True:
                ch = self.process.stderr.read(1)
                if ch == "":
                    break
                buf += ch
                if ch in "\r\n":
                    self._parse_status(buf)
                    buf = ""
                elif len(buf) > 4096:
                    self._parse_status(buf)
                    buf = ""
                if self._stop:
                    break

            if buf:
                self._parse_status(buf)

            rc = self.process.wait()
            self.final_rc = rc
            if self._stop:
                self.status = "ОСТАНОВЛЕНО"
                self._append_log("■ Запись остановлена пользователем")
            elif rc == 0:
                self.status = "СИНХРОНИЗАЦИЯ"
                self._append_log("→ Выполняется sync…")
                sync_rc = subprocess.run(["sudo", "sync"], check=False).returncode
                if sync_rc != 0:
                    raise RuntimeError("sync завершился с ошибкой")
                self.status = "ГОТОВО"
                if self.image_size:
                    self.written = self.image_size
                    self.percent = 100
                self._append_log("✓ Запись и синхронизация завершены")
            else:
                self.status = "ОШИБКА"
                self._append_log(f"✗ dd завершился с кодом {rc}")
        except Exception as e:
            self.status = "ОШИБКА"
            self._append_log(f"✗ {e}")
        finally:
            self.elapsed = time.monotonic() - self.start
            self.app.ui_queue.put(("done", self))

    def stop(self):
        self._stop = True
        try:
            if self.process and self.process.poll() is None:
                self.process.send_signal(signal.SIGTERM)
        except Exception:
            pass


