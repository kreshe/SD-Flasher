            save_last_image(p.resolve())
            low = p.name.lower()
            suffix = "сжатый образ" if low.endswith((".xz", ".gz", ".zst")) else "образ IMG"
            size_text = "размер неизвестен" if suffix == "сжатый образ" else human_bytes(p.stat().st_size)
