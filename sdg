            self.image_info_var.set(info)
            if hasattr(self, "image_name_label"):
                self.image_name_label.config(text=p.name, fg=TEXT)
            if hasattr(self, "image_icon_label"):
                self.image_icon_label.config(text=("IMG" if low.endswith(".img") else "ZIP"), fg=ACCENT)
            if hasattr(self, "image_hint"):
                self.image_hint.config(text=str(p))
        elif self.image_var.get().strip():
            self.image_info_var.set("⚠  Файл не найден")
            if hasattr(self, "image_name_label"):
                self.image_name_label.config(text="Образ не найден", fg=RED)
            if hasattr(self, "image_icon_label"):
                self.image_icon_label.config(text="!", fg=RED)
            if hasattr(self, "image_hint"):
                self.image_hint.config(text="Проверьте путь или выберите другой образ.", fg=RED)
        else:
            self.image_info_var.set("Выберите образ для записи")
            if hasattr(self, "image_name_label"):
                self.image_name_label.config(text="Образ не выбран", fg=MUTED)
            if hasattr(self, "image_icon_label"):
                self.image_icon_label.config(text="IMG", fg=MUTED)
