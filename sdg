            self.device_vars[path].set(value)
        self.update_selection_counter()

    def select_all(self):
        for v in self.device_vars.values():
            v.set(True)
        self.update_selection_counter()

    def clear_all(self):
        for v in self.device_vars.values():
            v.set(False)
        self.update_selection_counter()

    def update_selection_counter(self):
        count = sum(1 for v in self.device_vars.values() if v.get())
        total = len(self.device_vars)
        self.selected_count_var.set(f"Выбрано: {count} из {total}")
        if not self.running:
            self.start_button.config(state="normal" if count and self.image_var.get().strip() else "normal")
        self.after(250, self.update_selection_counter)

    def refresh_devices(self):
        try:
            disks = get_disks()
        except Exception as e:
            messagebox.showerror(APP_NAME, str(e))
            return

        old = {p: v.get() for p, v in self.device_vars.items()}
        for w in self.device_inner.winfo_children():
            w.destroy()
        self.device_vars.clear()
        self.devices = {d["path"]: d for d in disks}
        self.device_rows.clear()

        for idx, d in enumerate(disks):
            self._create_device_row(d, old.get(d["path"], False), idx)

        system = root_disk() or "не определён"
        summary = f"Найдено: {len(disks)}    ·    Системный диск: {system}"
        self.device_summary_var.set(summary)
        self.update_selection_counter()

        if not disks:
            box = tk.Frame(self.device_inner, bg="#0d1727", padx=15, pady=18)
            box.pack(fill="x", pady=6)
            self._label(box, "SD / USB накопители не найдены", 11, YELLOW, True, bg="#0d1727").pack(anchor="w")
            self._label(box, "Подключите карту через кардридер и нажмите «Обновить». Системный диск защищён.", 9, MUTED, bg="#0d1727").pack(anchor="w", pady=(4, 0))

    def _create_device_row(self, d, selected=False, idx=0):
        bg = "#132238" if idx % 2 == 0 else "#101d30"
        border = "#29415f" if selected else BORDER
        row = tk.Frame(self.device_inner, bg=bg, padx=10, pady=10, highlightbackground=border, highlightthickness=1)
        row.pack(fill="x", pady=3)
        var = tk.BooleanVar(value=selected)
        self.device_vars[d["path"]] = var
        self.device_rows[d["path"]] = row

        top = tk.Frame(row, bg=bg)
        top.pack(fill="x")
        cb = tk.Checkbutton(top, variable=var, command=lambda p=d["path"]: self._device_changed(p),
                            bg=bg, activebackground=bg, selectcolor="#203b5c", bd=0,
                            highlightthickness=0, width=2)
        cb.pack(side="left", padx=(0, 5))
        self._label(top, d["path"], 11, TEXT, True, bg=bg).pack(side="left")
        self._label(top, d["size"], 9, ACCENT, True, bg=bg).pack(side="left", padx=10)

        state_color = YELLOW if d["state"] == "СМОНТИРОВАН" else GREEN if d["state"] == "ГОТОВ" else RED
        state_bg = "#3b2f11" if d["state"] == "СМОНТИРОВАН" else "#10352d" if d["state"] == "ГОТОВ" else "#3d1d2a"
        tk.Label(top, text=d["state"], bg=state_bg, fg=state_color, font=(FONT, 7, "bold"), padx=8, pady=3).pack(side="right")

        model = d["model"]
        if d["mounts"]:
            model += f"  ·  {len(d['mounts'])} смонт."
        sub = tk.Frame(row, bg=bg)
        sub.pack(fill="x", pady=(4, 0), padx=(35, 0))
        self._label(sub, model[:70], 8, TEXT_2, bg=bg, anchor="w").pack(side="left", fill="x", expand=True)
        transport = d["tran"].upper() if d["tran"] else "USB"
        self._label(sub, f"{transport}  ·  {d['serial']}", 7, MUTED, bg=bg).pack(side="right")

    def _device_changed(self, path):
        row = self.device_rows.get(path)
        if row and path in self.device_vars:
            bg = "#132238" if list(self.device_rows).index(path) % 2 == 0 else "#101d30"
            border = "#29415f" if self.device_vars[path].get() else BORDER
            row.configure(highlightbackground=border)
        self.update_selection_counter()

    def selected_devices(self):
        return [p for p, v in self.device_vars.items() if v.get()]

    def clear_logs(self):
        for w in self.logs_inner.winfo_children():
            w.destroy()

    def create_job_card(self, job):
        if hasattr(self, "empty_monitor") and self.empty_monitor.winfo_exists():
            self.empty_monitor.destroy()

        count = len(self.jobs) if self.jobs else 1
        col = (count - 1) % 2
        row_no = (count - 1) // 2
        self.logs_inner.grid_columnconfigure(0, weight=1, uniform="jobs")
        self.logs_inner.grid_columnconfigure(1, weight=1, uniform="jobs")

        frame = tk.Frame(self.logs_inner, bg="#0d1727", padx=13, pady=12,
                         highlightbackground=BORDER, highlightthickness=1)
        frame.grid(row=row_no, column=col, sticky="nsew", padx=5, pady=5)

        top = tk.Frame(frame, bg="#0d1727")
        top.pack(fill="x")
        icon = tk.Label(top, text="●", bg="#0d1727", fg=YELLOW, font=(FONT, 10, "bold"))
        icon.pack(side="left", padx=(0, 7))
        self._label(top, job.device, 11, TEXT, True, bg="#0d1727").pack(side="left")
        meta = tk.Label(top, text="", bg="#0d1727", fg=MUTED, font=(FONT, 7))
        meta.pack(side="left", padx=9)
        status = tk.Label(top, text="ПОДГОТОВКА", bg="#3b2f11", fg=YELLOW,
                          font=(FONT, 7, "bold"), padx=8, pady=4)
        status.pack(side="right")

        progress_line = tk.Frame(frame, bg="#0d1727")
        progress_line.pack(fill="x", pady=(12, 5))
        pb = ttk.Progressbar(progress_line, mode="indeterminate", maximum=100)
        pb.pack(side="left", fill="x", expand=True, padx=(0, 9))
        percent = tk.Label(progress_line, text="—", bg="#0d1727", fg=TEXT,
                           font=(FONT, 10, "bold"), width=6, anchor="e")
        percent.pack(side="right")

        stats = tk.Label(frame, text="", bg="#0d1727", fg=TEXT_2, font=(FONT, 8), anchor="w")
        stats.pack(fill="x", pady=(0, 5))

        log_title = tk.Frame(frame, bg="#0d1727")
        log_title.pack(fill="x", pady=(5, 4))
        self._label(log_title, "● LIVE LOG", 7, GREEN, True, bg="#0d1727").pack(side="left")
        self._label(log_title, "последние сообщения", 7, MUTED, bg="#0d1727").pack(side="right")

        log = tk.Text(frame, height=8, bg=LOG_BG, fg=LOG_TEXT, insertbackground=TEXT,
                      relief="flat", borderwidth=0, highlightthickness=1,
                      highlightbackground="#18304a", font=(MONO, 8), wrap="word", padx=8, pady=7)
        log.pack(fill="x")
        log.configure(state="disabled")

        footer = tk.Frame(frame, bg="#0d1727")
        footer.pack(fill="x", pady=(7, 0))
        log_path = tk.Label(footer, text=f"{job.log_path}", bg="#0d1727", fg="#50647d",
                            font=(FONT, 7), anchor="w")
        log_path.pack(side="left", fill="x", expand=True)

        job.widgets = {
            "frame": frame, "icon": icon, "status": status, "meta": meta,
            "pb": pb, "percent": percent, "stats": stats, "log": log,
        }

    def update_job_widget(self, job):
        w = job.widgets
        elapsed = max(job.elapsed, time.monotonic() - job.start)
        mins = int(elapsed // 60)
        secs = int(elapsed % 60)
        pct = f"{job.percent}%" if job.percent is not None else "—"
        written = human_bytes(job.written)
        w["percent"].config(text=pct)
        w["stats"].config(text=f"Записано  {written}     ·     Скорость  {job.speed}     ·     Время  {mins:02d}:{secs:02d}")

        palette = {
            "ПОДГОТОВКА": (YELLOW, "#3b2f11"),
            "ЗАПИСЬ": (ACCENT, "#0b3440"),
            "СИНХРОНИЗАЦИЯ": (ACCENT_2, "#16365b"),
            "ГОТОВО": (GREEN, "#10352d"),
            "ОШИБКА": (RED, "#3d1d2a"),
            "ОСТАНОВЛЕНО": (ORANGE, "#3c2818"),
        }
        fg, bg = palette.get(job.status, (TEXT_2, CARD_2))
        w["status"].config(text=job.status, fg=fg, bg=bg)
        w["icon"].config(fg=GREEN if job.status == "ГОТОВО" else RED if job.status == "ОШИБКА" else ACCENT if job.status == "ЗАПИСЬ" else YELLOW)

        if job.percent is None and job.status not in {"ГОТОВО", "ОШИБКА", "ОСТАНОВЛЕНО"}:
            if str(w["pb"]["mode"]) != "indeterminate":
                w["pb"]["mode"] = "indeterminate"
                w["pb"].start(10)
        else:
            try:
                w["pb"].stop()
            except Exception:
                pass
            w["pb"]["mode"] = "determinate"
            w["pb"]["value"] = job.percent or 0

        text = "\n".join(job.log_lines[-9:])
        w["log"].configure(state="normal")
        w["log"].delete("1.0", "end")
        w["log"].insert("end", text)
        w["log"].see("end")
        w["log"].configure(state="disabled")

    def update_spinner(self):
        if self.running:
            self.spinner_idx = (self.spinner_idx + 1) % len(SPINNER)
            self.header_state.config(text=f"{SPINNER[self.spinner_idx]}  ЗАПИСЬ В ПРОЦЕССЕ", fg=ACCENT)
        else:
            self.header_state.config(text="●  ГОТОВ", fg=GREEN)
        self.after(120, self.update_spinner)

    def start_flash(self):
        if self.running:
            return
        image = Path(self.image_var.get()).expanduser()
        if not image.is_file():
            messagebox.showerror(APP_NAME, "Выберите существующий файл образа.")
            return
        if not image.name.lower().endswith(IMAGE_EXTENSIONS):
            messagebox.showerror(APP_NAME, "Неподдерживаемый формат образа.")
            return

        selected = self.selected_devices()
        if not selected:
            messagebox.showwarning(APP_NAME, "Выберите хотя бы один накопитель.")
            return

        try:
            disks = {d["path"]: d for d in get_disks()}
        except Exception as e:
            messagebox.showerror(APP_NAME, str(e))
            return

        missing = [d for d in selected if d not in disks]
        if missing:
            messagebox.showerror(APP_NAME, "Эти устройства больше не обнаружены:\n" + "\n".join(missing))
            self.refresh_devices()
            return

        system = root_disk()
        unsafe = [d for d in selected if d == system or disks[d]["ro"]]
        if unsafe:
            messagebox.showerror(APP_NAME, "Нельзя записывать на:\n" + "\n".join(unsafe))
            return

        image_size = None
        if not image.name.lower().endswith((".xz", ".gz", ".zst")):
            image_size = image.stat().st_size
            too_small = []
            for d in selected:
                rc, out, _ = run_cmd(["blockdev", "--getsize64", d])
                if rc == 0 and out.strip().isdigit() and int(out.strip()) < image_size:
                    too_small.append(d)
            if too_small:
                messagebox.showerror(APP_NAME, "Образ больше следующих накопителей:\n\n" + "\n".join(too_small))
                return

        save_last_image(image.resolve())
        details = "\n".join(f"• {d}    {disks[d]['size']}    {disks[d]['model']}" for d in selected)
        message = (
            f"ОБРАЗ\n{image}\n\n"
            f"ЦЕЛИ: {len(selected)}\n{details}\n\n"
            "ВСЕ ДАННЫЕ НА ВЫБРАННЫХ НАКОПИТЕЛЯХ БУДУТ УДАЛЕНЫ.\n\n"
            "Начать параллельную запись?"
        )
        if not messagebox.askyesno(APP_NAME, message, icon="warning"):
            return

        self.running = True
        self.start_button.config(state="disabled")
        self.stop_button.config(state="normal")
        self.status_var.set("Подготовка накопителей…")
        self.clear_logs()
        self.jobs = []
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%d_%H%M%S")

        for d in selected:
            try:
                messages = unmount_disk(d)
                for line in messages:
                    self.status_var.set(f"{d}: {line}")
                    self.update_idletasks()
            except Exception as e:
                self.running = False
                self.start_button.config(state="normal")
                self.stop_button.config(state="disabled")
                messagebox.showerror(APP_NAME, f"Не удалось подготовить {d}:\n{e}")
                return

        for idx, d in enumerate(selected, 1):
            safe = Path(d).name.replace("/", "_")
            log_path = LOG_DIR / f"{safe}_{stamp}_{os.getpid()}_{idx}.log"
            job = FlashJob(self, d, image.resolve(), log_path, image_size)
            self.jobs.append(job)
            self.create_job_card(job)

        for job in self.jobs:
            job.start_job()

        self.status_var.set(f"Запись запущена на {len(self.jobs)} накопителях")

    def stop_all(self):
        if not self.running:
            return
        if not messagebox.askyesno(APP_NAME, "Остановить активные записи? Частично записанные карты могут стать нечитаемыми.", icon="warning"):
            return
        for job in self.jobs:
            job.stop()
        self.status_var.set("Остановка записей…")

    def update_jobs(self):
        if self.jobs:
            for job in self.jobs:
                self.update_job_widget(job)

            if self.running and all(job.status in {"ГОТОВО", "ОШИБКА", "ОСТАНОВЛЕНО"} for job in self.jobs):
                self.running = False
                self.start_button.config(state="normal")
                self.stop_button.config(state="disabled")
                ok = sum(job.status == "ГОТОВО" for job in self.jobs)
                fail = len(self.jobs) - ok
                if fail == 0:
                    self.status_var.set(f"✓ Все операции завершены · успешно: {ok}")
                else:
                    self.status_var.set(f"Завершено · успешно: {ok} · ошибок: {fail}")
        self.after(400, self.update_jobs)

    def process_queue(self):
        try:
            while True:
                _, job = self.ui_queue.get_nowait()
                self.update_job_widget(job)
        except queue.Empty:
            pass
        self.after(100, self.process_queue)

    def on_close(self):
        if self.running:
            if not messagebox.askyesno(APP_NAME, "Запись ещё выполняется. Закрыть окно и остановить её?", icon="warning"):
                return
            for job in self.jobs:
                job.stop()
            self.after(700, self.destroy)
            return
        self.destroy()


def main():
    required = ["lsblk", "findmnt", "udevadm", "sudo", "dd", "umount", "sync", "blockdev"]
    missing = [x for x in required if shutil.which(x) is None]
    if missing:
        raise SystemExit("Не найдены команды: " + ", ".join(missing))
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    app = SDFlasherGUI()
    app.mainloop()


if __name__ == "__main__":
    main()
